# Copy this file to `.env.local` and fill in your key and secret.
# `.env.local` is git-ignored, and these variables have NO `NEXT_PUBLIC_` prefix,
# so they are only readable on the server (lib/binance-web3.ts) — never in the browser.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Public address of the deployed site, used for link previews (Open Graph /
# Twitter cards). Not secret. On Vercel this can be left empty.
NEXT_PUBLIC_SITE_URL=
